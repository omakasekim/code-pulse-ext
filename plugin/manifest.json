{
  "manifest_version": 3,
  "name": "code-pulse-ext — Aether Visual Developer Overlay",
  "version": "1.0.0",
  "description": "React/Vue/Linux/Flutter/TensorFlow blast-radius dependency graph, JS scope/closure/prototype X-Ray, and commit cadence burnout heatmap",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://github.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "code-pulse-ext"
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
